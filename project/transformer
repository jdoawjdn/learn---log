import torch, torch.nn as nn, torch.nn.functional as F
import urllib.request, os, math

torch.manual_seed(1337)
device = 'cuda' if torch.cuda.is_available() else 'cpu'

# ---------- 数据 ----------
if not os.path.exists('input.txt'):
    urllib.request.urlretrieve(
        "https://raw.githubusercontent.com/karpathy/char-rnn/master/data/tinyshakespeare/input.txt",
        "input.txt")
text = open('input.txt', encoding="utf-8").read()

chars = sorted(set(text))
stoi = {c: i for i, c in enumerate(chars)}
itos = {i: c for c, i in stoi.items()}
encode = lambda s: [stoi[c] for c in s]
decode = lambda l: ''.join(itos[i] for i in l)          # ✅ 新增：id → 字符串
data = torch.tensor(encode(text), dtype=torch.long)
n = int(0.8 * len(data))
train_data, val_data = data[:n], data[n:]

block_size = 32

def get_batch(split):
    d = train_data if split == "train" else val_data
    ix = torch.randint(len(d) - block_size, (64,))
    x = torch.stack([d[i:i+block_size] for i in ix])
    y = torch.stack([d[i+1:i+block_size+1] for i in ix])
    return x.to(device), y.to(device)

# ---------- 单头注意力 ----------
class Head(nn.Module):
    def __init__(self, n_embd, head_size, block_size):
        super().__init__()
        self.key   = nn.Linear(n_embd, head_size, bias=False)
        self.query = nn.Linear(n_embd, head_size, bias=False)
        self.value = nn.Linear(n_embd, head_size, bias=False)
        self.register_buffer("tril", torch.tril(torch.ones(block_size, block_size)))

    def forward(self, x):
        B, T, C = x.shape
        q = self.query(x)
        k = self.key(x)
        v = self.value(x)
        wei = q @ k.transpose(-2, -1) / math.sqrt(q.shape[-1])
        wei = wei.masked_fill(self.tril[:T, :T] == 0, float('-inf'))
        wei = F.softmax(wei, dim=-1)
        return wei @ v

# ---------- 前馈 ----------
class FeedForward(nn.Module):
    def __init__(self, n_embd):
        super().__init__()
        self.net = nn.Sequential(
            nn.Linear(n_embd, 4 * n_embd),
            nn.ReLU(),
            nn.Linear(4 * n_embd, n_embd),
        )
    def forward(self, x):
        return self.net(x)

# ---------- 多头注意力 ----------
class MultiHeadAttention(nn.Module):
    def __init__(self, num_head, n_embd, block_size):
        super().__init__()
        head_size = n_embd // num_head
        self.heads = nn.ModuleList(
            [Head(n_embd, head_size, block_size) for _ in range(num_head)])
        self.proj = nn.Linear(n_embd, n_embd)

    def forward(self, x):
        out = torch.cat([h(x) for h in self.heads], dim=-1)
        return self.proj(out)

# ---------- Transformer Block ----------
class Block(nn.Module):
    def __init__(self, n_embd, num_head, block_size):
        super().__init__()
        self.sa   = MultiHeadAttention(num_head, n_embd, block_size)
        self.ffwd = FeedForward(n_embd)
        self.ln1  = nn.LayerNorm(n_embd)
        self.ln2  = nn.LayerNorm(n_embd)

    def forward(self, x):
        x = x + self.sa(self.ln1(x))
        x = x + self.ffwd(self.ln2(x))
        return x

# ---------- 模型 ----------
class BigramLikeModel(nn.Module):
    def __init__(self, vocab_size, n_embd=32, num_head=4, block_size=8):
        super().__init__()
        self.block_size = block_size                       # ✅ 保存，generate 用
        self.token_embedding = nn.Embedding(vocab_size, n_embd)
        self.position_embedding = nn.Embedding(block_size, n_embd)   # ✅ 新增：位置编码
        self.block = nn.Sequential(
            Block(n_embd, num_head, block_size),
            Block(n_embd, num_head, block_size),
            Block(n_embd, num_head, block_size),
            Block(n_embd, num_head, block_size),
            Block(n_embd, num_head, block_size),
            Block(n_embd, num_head, block_size),
            
        )
        self.ln_f = nn.LayerNorm(n_embd)
        self.lm_head = nn.Linear(n_embd, vocab_size)

    def forward(self, idx, targets=None):
        B, T = idx.shape

        tok_emb = self.token_embedding(idx)                # (B,T,n_embd)
        pos_emb = self.position_embedding(                 # ✅ 位置编码
            torch.arange(T, device=idx.device))            # (T,n_embd)
        x = tok_emb + pos_emb                              # 广播相加 (B,T,n_embd)

        x = self.block(x)
        x = self.ln_f(x)
        logits = self.lm_head(x)                           # (B,T,vocab)

        loss = None
        if targets is not None:
            B, T, V = logits.shape
            loss = F.cross_entropy(logits.view(B*T, V), targets.view(B*T))
        return logits, loss

    @torch.no_grad()
    def generate(self, idx, max_new_tokens):               # ✅ 新增：文本生成
        for _ in range(max_new_tokens):
            idx_cond = idx[:, -self.block_size:]           # 只保留最近 block_size 个
            logits, _ = self(idx_cond)                     # (B,T,vocab)
            logits = logits[:, -1, :]                      # 取最后一个位置 (B,vocab)
            probs = F.softmax(logits, dim=-1)              # 概率
            idx_next = torch.multinomial(probs, num_samples=1)  # 采样 1 个
            idx = torch.cat([idx, idx_next], dim=1)        # 拼到末尾
        return idx

# ---------- 验证集评估 ----------
@torch.no_grad()
def estimate_loss(model, eval_iters=20):                   # ✅ 新增
    model.eval()
    out = {}
    for split in ["train", "val"]:
        losses = torch.zeros(eval_iters)
        for k in range(eval_iters):
            x, y = get_batch(split)
            _, loss = model(x, y)
        out[split] = losses.mean().item()
    model.train()
    return out

# ---------- 训练 ----------
model = BigramLikeModel(len(chars), n_embd=32, num_head=4,block_size = block_size).to(device)
opt = torch.optim.AdamW(model.parameters(), lr=1e-2)

for step in range(1000):
    x, y = get_batch("train")
    _, loss = model(x, y)
    opt.zero_grad(set_to_none=True)
    loss.backward()
    opt.step()

    if step % 500 == 0:
        losses = estimate_loss(model)                      # ✅ 每 100 步评估
        print(f"step {step}: train {losses['train']:.4f}, val {losses['val']:.4f}")

# ---------- 生成 ----------
context = torch.zeros((1, 1), dtype=torch.long, device=device)   # 起始符 id=0
print("\n生成的文本:\n")
print(decode(model.generate(context, max_new_tokens=200)[0].tolist()))