from openai import OpenAI
import os
import json
client = OpenAI(
    api_key = 'YOUR_API_KEY',
    base_url = 'BASE_URL'
)
Question = '你觉得人工智能会取代人类吗？'
prompt = {
    "role1":Question,
    "role2":"你是一个小学生，请回这个问题" + Question,
    "role3":"你是一个资深的人工智能专家，请回答这个问题"+Question,
}
results = {}
for name, p in prompt.items():
    r = client.chat.completions.create(
        model = "qwen3.8-flash",
        messages = [{"role":"user","content":p}],temperature=0.3)
    results[name] = r.choices[0].message.content
with open("results.json", "w", encoding="utf-8") as f:
    json.dump(results, f, ensure_ascii=False, indent=2)
print("已保存 results.json")